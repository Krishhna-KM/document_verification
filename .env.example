# Copy to .env and fill in.

# "ocr_api"  = internal /v1/ocr endpoint (multipart file upload, answer returned in "text")
# "openai"   = any OpenAI-compatible /chat/completions endpoint (vLLM, Ollama, hosted gateways ...)
# "mock"     = no model call; echoes the request metadata back (ONLY for testing the plumbing/UI)
MODEL_PROVIDER=mock

# ocr_api: full URL of the endpoint, e.g. http://<host>:<port>/v1/ocr
# openai : full URL, or just the base (".../v1") - "/chat/completions" is appended if missing
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=qwen2.5vl:7b
MODEL_TIMEOUT_SECONDS=600
MODEL_MAX_TOKENS=4096
# Max prompt length the endpoint accepts (the /v1/ocr endpoint rejects > 4000). 0 = no limit
MODEL_PROMPT_MAX_CHARS=3900

# Document handling
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=3
IMAGE_MAX_SIDE=2000

# A key scoring at least this (but not a full match) is reported as PARTIALLY_MATCHED, below it NOT_MATCHED.
PARTIAL_MATCH_MIN_SCORE=65

HOST=127.0.0.1
PORT=5000
DEBUG=true
